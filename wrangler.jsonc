{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-opencode",
  "account_id": "ad5ec479b9a421faa2ed06c3d1c2b23a",
  "main": "src/index.ts",
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "WORKSPACE_REPO": "https://github.com/chester-hill-solutions/opencode-slack",
    "OPENCODE_MODEL": "opencode/deepseek-v4.1-flash",
    "CHECKIN_SECONDS": "45"
  },
  "containers": [
    {
      "class_name": "Conversation",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Conversation", "name": "CONVERSATION" }]
  },
  "r2_buckets": [{ "binding": "CHECKPOINTS", "bucket_name": "cf-opencode-checkpoints" }],
  "exports": {
    "Conversation": { "type": "durable-object", "storage": "sqlite" }
  }
}
