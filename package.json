{
  "name": "cf-opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode harness on Cloudflare: a Durable Object per conversation, local S3 (stow-s3) for the hot workspace, R2 for cold checkpoints, and an HTTP/SSE core with pluggable adapters.",
  "license": "MIT",
  "workspaces": [
    "packages/ui"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "build:ui": "bun scripts/build-ui.ts",
    "dev:ui": "bun scripts/dev-ui.ts",
    "deploy": "wrangler deploy",
    "typecheck": "bun scripts/native-storage-qualification/build-probe.ts && bun scripts/provider-egress-qualification/build-probe.ts && tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.worker-tests.json && tsc -p tsconfig.ui.json && tsc -p scripts/native-storage-qualification/tsconfig.json && tsc -p scripts/provider-egress-qualification/tsconfig.json && bun run --cwd runtime/opencode typecheck",
    "check:config": "bun scripts/check-config.mjs",
    "test": "bun scripts/native-storage-qualification/build-probe.ts && bun scripts/provider-egress-qualification/build-probe.ts && bun test tests scripts/native-storage-qualification/*.test.ts scripts/provider-egress-qualification/*.test.ts && bun run --cwd runtime/opencode test",
    "test:workers": "vitest run",
    "qualification:preflight": "bun scripts/native-storage-qualification/build-probe.ts && tsc -p scripts/native-storage-qualification/tsconfig.json && bun test scripts/native-storage-qualification/*.test.ts && bun scripts/native-storage-qualification/preflight.ts",
    "qualification:local": "bun scripts/native-storage-qualification/build-probe.ts && bun scripts/native-storage-qualification/local-matrix.ts",
    "smoke:container": "bash scripts/smoke-container.sh",
    "bench": "bun run bench/measure.ts",
    "bench:container": "bash bench/container.sh",
    "qualification:provider-egress": "bun scripts/provider-egress-qualification/build-probe.ts && tsc -p scripts/provider-egress-qualification/tsconfig.json && bun test scripts/provider-egress-qualification/*.test.ts && bun scripts/provider-egress-qualification/preflight.ts",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
    "check:lint-ratchet": "node scripts/check-lint-ratchet.mjs",
    "tools:lint-ratchet:baseline": "node scripts/check-lint-ratchet.mjs --baseline",
    "check:dry": "node scripts/check-dry.mjs",
    "tools:dry:baseline": "node scripts/check-dry.mjs --update",
    "check:telemetry": "node scripts/check-telemetry.mjs",
    "tools:telemetry:baseline": "node scripts/check-telemetry.mjs --update",
    "check:file-size": "node scripts/check-file-size.mjs",
    "tools:file-size:baseline": "node scripts/check-file-size.mjs --update",
    "check:strict-types": "node scripts/check-strict-types.mjs",
    "tools:strict-types:baseline": "node scripts/check-strict-types.mjs --update",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:quality": "bun run check:lint-ratchet && bun run check:strict-types && bun run check:dry && bun run check:telemetry && bun run check:file-size",
    "ci:local": "bun run check:config && bun run typecheck && bun scripts/provider-egress-qualification/preflight.ts && bun run build:ui && bun run check:quality && bun run check:client-bundle && bun run test && bun run test:workers"
  },
  "dependencies": {
    "@aboiteau/ui": "workspace:*",
    "@chester-hill-solutions/vault": "file:vendor/chester-hill-solutions/vault",
    "@opencode/client": "latest",
    "agents": "0.33.0",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@chester-hill-solutions/ratchet-strap": "./tools/vendor/chester-hill-solutions-ratchet-strap-0.4.0.tgz",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "9",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "6",
    "eslint-plugin-react": "7",
    "eslint-plugin-react-hooks": "7",
    "globals": "15",
    "jscpd": "5.4.3",
    "lucide-react": "^1.25.0",
    "playwright": "^1.65.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.105.0"
  }
}
