{
  "name": "cf-opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode harness on Cloudflare: a Durable Object per conversation, local S3 (stow-s3) for the hot workspace, R2 for cold checkpoints, and an HTTP/SSE core with pluggable adapters.",
  "license": "MIT",
  "workspaces": [
    "packages/ui"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "build:ui": "bun scripts/build-ui.ts",
    "dev:ui": "bun scripts/dev-ui.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.worker-tests.json && tsc -p tsconfig.ui.json && bun run --cwd runtime/opencode typecheck",
    "check:config": "bun scripts/check-config.mjs",
    "test": "bun test tests && bun run --cwd runtime/opencode test",
    "test:workers": "vitest run",
    "smoke:container": "bash scripts/smoke-container.sh",
    "bench": "bun run bench/measure.ts",
    "bench:container": "bash bench/container.sh"
  },
  "dependencies": {
    "@aboiteau/ui": "workspace:*",
    "@chester-hill-solutions/vault": "file:vendor/chester-hill-solutions/vault",
    "@opencode/client": "latest",
    "agents": "0.33.0",
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.25.0",
    "playwright": "^1.65.0",
    "recharts": "^3.8.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.105.0"
  }
}
