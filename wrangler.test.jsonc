{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-opencode-test",
  "main": "src/index.ts",
  "assets": { "directory": "./public" },
  "build": { "command": "bun run build:ui", "watch_dir": ["web", "packages/ui"] },
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WORKSPACE_REPO": "https://github.com/chester-hill-solutions/opencode-slack",
    "OPENCODE_MODEL": "opencode/deepseek-v4.1-flash",
    "POLL_SECONDS": "2",
    "EVENTED_CANARY_KEY": "event-retention-canary-test",
    "EVENTED_FRESH_CONVERSATIONS": "false"
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "Conversation", "name": "CONVERSATION" },
      { "class_name": "Settings", "name": "SETTINGS" }
    ]
  },
  "r2_buckets": [{ "binding": "CHECKPOINTS", "bucket_name": "cf-opencode-test" }],
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "exports": {
    "Conversation": { "type": "durable-object", "storage": "sqlite" },
    "Settings": { "type": "durable-object", "storage": "sqlite" }
  }
}
