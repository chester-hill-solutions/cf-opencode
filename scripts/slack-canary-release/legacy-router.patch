@@ -0,0 +1,46 @@
+import { expect, it } from "vitest"
+import { createExecutionContext, env } from "cloudflare:test"
+import worker from "../src/index"
+import type { Env } from "../src/env"
+import { verifySlackSignature } from "../src/adapters/slack"
+const channel = "C0A5YNXLP6C", ts = "1794780000.000001", delegation = "synthetic-delegation-" + "a".repeat(32)
+async function signed(body: string, valid = true) {
+  const timestamp = String(Math.floor(Date.now() / 1000)), bytes = new TextEncoder()
+  const key = await crypto.subtle.importKey("raw", bytes.encode("test-secret"), { name: "HMAC", hash: "SHA-256" }, false, ["sign"])
+  const mac = await crypto.subtle.sign("HMAC", key, bytes.encode(`v0:${timestamp}:${body}`))
+  return new Request("https://legacy.example/slack/events", { method: "POST", body, headers: { "content-type": "application/json", "x-slack-request-timestamp": timestamp, "x-slack-signature": valid ? "v0=" + Array.from(new Uint8Array(mac), b => b.toString(16).padStart(2, "0")).join("") : "v0=invalid" } })
+}
+function fixture(route: "canary" | "legacy" = "canary") {
+  let legacy = 0, delegated = 0
+  const refuse = <T extends object>(namespace: T): T => new Proxy(namespace, { get(target, property, receiver) { if (property === "getByName") return () => { legacy++; throw new Error("Legacy dispatch observed") }; return Reflect.get(target, property, receiver) } })
+  const config: Env = { ...env, CONVERSATION: refuse(env.CONVERSATION), SETTINGS: refuse(env.SETTINGS), SLACK_CANARY_CHANNEL: channel, SLACK_CANARY_ORIGIN: "https://isolated.example", SLACK_CANARY_SIGNING_SECRET: delegation, SLACK_CANARY: {
+    connect() { throw new Error("Unexpected connect") },
+    async fetch(input, init) {
+      delegated++
+      const req = new Request(input, init), body = await req.text()
+      expect(await verifySlackSignature({ signingSecret: delegation, timestamp: req.headers.get("x-slack-request-timestamp"), signature: req.headers.get("x-slack-signature"), body })).toBe(true)
+      return new URL(req.url).pathname === "/slack/canary-route" ? Response.json({ route, channel, threadTs: ts }) : new Response("ok")
+    },
+  } }
+  return { config, counts: () => ({ legacy, delegated }) }
+}
+it("invalid real Slack signature never reaches delegated probe or either legacy namespace", async () => {
+  const f = fixture(), body = JSON.stringify({ type: "event_callback", event: { type: "app_mention", channel, ts, text: "!help" } })
+  expect((await worker.fetch(await signed(body, false), f.config, createExecutionContext())).status).toBe(401)
+  expect(f.counts()).toEqual({ legacy: 0, delegated: 0 })
+})
+it("owned target forwards after real HMAC and before any legacy registry or conversation access", async () => {
+  const f = fixture(), body = JSON.stringify({ type: "event_callback", event: { type: "app_mention", channel, ts, text: "!help" } })
+  expect((await worker.fetch(await signed(body), f.config, createExecutionContext())).status).toBe(200)
+  expect(f.counts()).toEqual({ legacy: 0, delegated: 2 })
+})
+it("unowned old thread still reaches original legacy dispatch", async () => {
+  const f = fixture("legacy"), body = JSON.stringify({ type: "event_callback", event: { type: "app_mention", channel, ts, thread_ts: ts, text: "!help" } })
+  await expect(worker.fetch(await signed(body), f.config, createExecutionContext())).rejects.toThrow("Legacy dispatch observed")
+  expect(f.counts().legacy).toBeGreaterThan(0); expect(f.counts().delegated).toBe(1)
+})
+it("other channels never probe canary and still reach original dispatch", async () => {
+  const f = fixture(), body = JSON.stringify({ type: "event_callback", event: { type: "app_mention", channel: "COLD", ts, text: "!help" } })
+  await expect(worker.fetch(await signed(body), f.config, createExecutionContext())).rejects.toThrow("Legacy dispatch observed")
+  expect(f.counts().legacy).toBeGreaterThan(0); expect(f.counts().delegated).toBe(0)
+})
diff --git a/tests/slack-canary-router.test.ts b/tests/slack-canary-router.test.ts
