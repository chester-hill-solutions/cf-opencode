{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["bun", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "web",
    "packages/ui/src",
    "scripts/build-ui.ts",
    "scripts/dev-ui.ts",
    "scripts/test-ui.ts",
    "scripts/ui-server.ts"
  ]
}
